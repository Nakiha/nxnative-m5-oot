# M5/Ocarina of Time development baseline; no stutter-free 60 fps claim.
# Use with --env-file; keep experimental scheduling and network substitutions off.
DM_AUDIO=1
DM_HDR=1
DM_HDR_INPUT=pq2020
DM_HDR_PEAK_NITS=1000
DM_LANG=zh-Hans
DM_FULLSCREEN=0
DM_FOCUS_KEEP=1
DM_FPS_HOLD=off
DM_METAL_HUD=0
DM_GFX_SCALE=1
DM_OPMODE=1
DM_DYNAMIC_RESOLUTION=0
DM_RENDER_SCALE=1
DM_UPSCALER=game
DM_PRESENT_UPSCALE=off
DM_PRESENT_SNAP=0
DM_PSO_MTL4=1
DM_PSO_PREBUILD=1
DM_FPS_TARGET=60
DM_HMMA_TENSOR=0
DM_NVN_ENC_THREAD=1
DM_NVN_DISPATCH_OVERLAP=1
DM_NVN_ENC_ASYNC=1
DM_NVN_CUT=32
DM_NVN_CUT_BUSY=0
DM_NVN_MESH_SCRATCH=4096
DM_NVN_PREPARE_COMMANDS=0
DM_NVN_QDEFER=0
DM_NVN_COMPUTE_GAME_BAR=0
DM_NVN_CUT_FIRST=0
DM_RT_PRESENT=0
